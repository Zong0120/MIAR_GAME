  m_Script: {fileID: 11500000, guid: 6aab352a4aa36472a9ad4de79580327d, type: 3}
  m_Name: chapter6
  m_EditorClassIdentifier: 
  title: "\u8F49\u6369"
  content: "\u6700\u8FD1\u7684\u63A2\u7D22\u8B8A\u5F97\u6108\u767C\u56F0\u96E3\u3002\u5712\u5340\u88E1\u958B\u59CB\u51FA\u73FE\u300C\u9B3C\u9B45\u300D\uFF0C\u4E14\u6578\u91CF\u96A8\u8457\u6211\u9192\u4F86\u7684\u6B21\u6578\uFF0C\u6709\u8B8A\u5F97\u6108\u4F86\u6108\u591A\u7684\u8DA8\u52E2\u3002\n\n\u300C\u9B3C\u9B45\u300D\u7684\u5916\u578B\u5F88\u50CF\u5E7D\u9748\uFF0C\u4F46\u8EAB\u908A\u7E3D\u6F02\u6D6E\u8457\u4E82\u78BC\uFF0C\u5C0E\u81F4\u6211\u770B\u4E0D\u6E05\u695A\u300C\u7942\u300D\u7684\u771F\u5BE6\u6A23\u8C8C\u3002\u300C\u7942\u300D\u79FB\u52D5\u901F\u5EA6\u98DB\u5FEB\uFF0C\u4E14\u611F\u5B98\u9748\u654F\uFF0C\u7A0D\u6709\u52D5\u975C\u4FBF\u6703\u88AB\u5BDF\u89BA\u3002\u5E78\u904B\u7684\u662F\uFF0C\u7D93\u904E\u9577\u6642\u9593\u7684\u89C0\u5BDF\uFF0C\u6211\u767C\u73FE\u300C\u7942\u300D\u4F3C\u4E4E\u6709\u56FA\u5B9A\u7684\u8DEF\u7DDA\uFF0C\u56E0\u6B64\u53EA\u8981\u9810\u5224\u6642\u6A5F\u4E26\u8FF4\u907F\u300C\u7942\u300D\uFF0C\u4FBF\u4E0D\u6703\u6709\u5371\u96AA\u3002\n\n\u64DA\u7D61\u816E\u9B0D\u5148\u751F\u6240\u8FF0\uFF0C\u300C\u9B3C\u9B45\u300D\u4FBF\u662F\u9020\u6210\u4E00\u5207\u7684\u539F\u56E0\u3002\u5F88\u4E45\u4EE5\u524D\uFF0C\u4F34\u96A8\u8457\u300C\u9B3C\u9B45\u300D\u7684\u51FA\u73FE\uFF0C\u53F2\u7121\u524D\u4F8B\u7684\u75AB\u60C5\u7206\u767C\uFF0C\u4EBA\u53E3\u6025\u907D\u6E1B\u5C11\uFF0C\u4F0A\u65AF\u6CE2\u5712\u5340\u4E5F\u5931\u53BB\u4E86\u5F80\u65E5\u7684\u751F\u6C23\u3002\n\n\u300C\u7D55\u5C0D\uFF0C\u7D55\u5C0D\u4E0D\u53EF\u4EE5\u548C\u300E\u7942\u300F\u63A5\u89F8\uFF01\u300D\u906D\u9047\u7B2C\u4E00\u96BB\u300C\u9B3C\u9B45\u300D\u5F8C\uFF0C\u7D61\u816E\u9B0D\u5148\u751F\u6293\u8457\u6211\u7684\u80A9\u8180\u56B4\u8085\u7684\u8B66\u544A\u6211\u3002\u300C\u5426\u5247\u4F60\u6703\u8B8A\u5F97\u8DDF\u4EE5\u524D\u7684\u4EBA\u4E00\u6A23\u6DF1\u9677\u5728\u75DB\u82E6\u4E2D\uFF0C\u50CF\u662F\u88AB\u5C01\u6B7B\u5728\u770B\u4E0D\u900F\u7A97\u5916\u7684\u7262\u7C60\u88E1\uFF0C\u6700\u5F8C\u5728\u75BE\u75C5\u7E8F\u8EAB\u4E0B\u75DB\u82E6\u7684\u6B7B\u53BB\u3002\u300D\n\n\u7167\u7406\u4F86\u8AAA\uFF0C\u6211\u5011\u5DF2\u7D93\u638C\u63E1\u4E86\u300C\u7942\u300D\u7684\u884C\u8E64\uFF0C\u7406\u61C9\u6703\u6BD4\u8F03\u5B89\u5168\uFF0C\u4F46\u4ECA\u5929\u4F3C\u4E4E\u6C92\u6709\u90A3\u9EBC\u8D70\u904B\u3002\u6211\u5011\u6642\u5E38\u7D93\u904E\u7684\u8DEF\u7DDA\u4E0A\u591A\u4E86\u65B0\u7684\u300C\u9B3C\u9B45\u300D\uFF0C\u7576\u67E5\u89BA\u5230\u6642\u5DF2\u7D93\u4F86\u4E0D\u53CA\u4E86\uFF0C\u96A8\u8457\u71C8\u5149\u7684\u9583\u720D\uFF0C\u300C\u9B3C\u9B45\u300D\u7684\u8EAB\u5F71\u4F34\u96A8\u8457\u4E82\u78BC\u7684\u5F62\u5F0F\u5F80\u6211\u5011\u7684\u65B9\u5411\u903C\u8FD1\u3002\n\n\u7D61\u816E\u9B0D\u5148\u751F\u727D\u8457\u6211\uFF0C\u5728\u4E0D\u540C\u7684\u5C55\u5340\u9593\u72C2\u5954\uFF0C\u60F3\u76E1\u8FA6\u6CD5\u8EB2\u907F\u300C\u9B3C\u9B45\u300D\u7684\u8FFD\u64CA\uFF0C\u4F46\u7121\u8AD6\u6211\u5011\u8EB2\u5230\u54EA\u88E1\uFF0C\u300C\u7942\u300D\u7E3D\u80FD\u627E\u5230\u6211\u5011\u3002\u53CD\u800C\u56E0\u70BA\u9A5A\u614C\u7684\u9003\u8DD1\uFF0C\u9A5A\u52D5\u4E86\u66F4\u591A\u300C\u9B3C\u9B45\u300D\uFF0C\u539F\u672C\u7684\u8FFD\u9010\u6230\u8B8A\u6210\u5305\u570D\u6230\u3002\u7576\u610F\u8B58\u5230\u6642\uFF0C\u6211\u5011\u5DF2\u7D93\u88AB\u56F0\u5728\u96FB\u68AF\u524D\u4E86\u3002\n\n\u7D61\u816E\u9B0D\u5148\u751F\u6309\u4E0B\u96FB\u68AF\u6309\u9215\uFF0C\u6211\u80FD\u611F\u89BA\u5230\u80CC\u5F8C\u96FB\u68AF\u7684\u92FC\u677F\u50B3\u4F86\u96FB\u68AF\u904B\u884C\u7684\u9707\u52D5\u3002\u9B3C\u9B45\u6B63\u5728\u903C\u8FD1\uFF0C\u7D61\u816E\u9B0D\u5148\u751F\u4F4E\u4E0B\u8EAB\u5B50\uFF0C\u62B1\u7DCA\u8457\u6211\u3002\n\n\u300C\u73FE\u5728\u7684\u5149\u666F\u5C31\u8DDF\u4EE5\u524D\u75AB\u60C5\u7206\u767C\u6642\u4E00\u6A23\uFF0C\u771F\u662F\u4EE4\u4EBA\u61F7\u5FF5\u300D\u4ED6\u5728\u6211\u8033\u908A\u4F4E\u8072\u8AAA\u9053\u3002\u300C\u76E1\u91CF\u9003\u8DD1\u5427\uFF0C\u8A18\u5F97\uFF0C\u76F8\u4FE1\u82AF\u7684\u5B58\u5728\uFF0C\u4E0D\u8981\u5C01\u9589\u81EA\u5DF1\u7684\u5167\u5FC3\uFF01\u300D\n\n\u96A8\u5F8C\uFF0C\u96FB\u68AF\u9580\u6253\u958B\u4E86\uFF0C\u7D61\u816E\u9B0D\u5148\u751F\u5C07\u6211\u63A8\u9032\u96FB\u68AF\u88E1\uFF0C\u5728\u6211\u53CD\u61C9\u904E\u4F86\u4E4B\u524D\uFF0C\u96FB\u68AF\u9580\u95DC\u4E0A\u4E86\uFF0C\u6211\u624D\u7D42\u65BC\u610F\u8B58\u5230\u7D61\u816E\u9B0D\u5148\u751F\u9084\u5728\u96FB\u68AF\u5916\u9762\u3002\u6211\u60F3\u8FFD\u4E0A\u5B83\uFF0C\u4F46\u96D9\u8173\u537B\u4E0D\u81EA\u89BA\u7684\u5728\u539F\u5730\u986B\u6296\u3002\n\n\u6C92\u591A\u4E45\u5F8C\uFF0C\u6211\u8EBA\u5728\u96FB\u68AF\u88E1\uFF0C\u518D\u6B21\u9032\u5165\u5922\u9109\u3002\n\n\u9019\u4E00\u6B21\uFF0C\u6709\u8457\u4E94\u5B98\u7684\u7D61\u816E\u9B0D\u5148\u751F\u4E26\u6C92\u6709\u539F\u5148\u727D\u8D77\u6211\u624B\u7684\u6EAB\u67D4\uFF0C\u53CD\u800C\u7528\u8457\u5931\u671B\u8207\u61A4\u6012\u7684\u773C\u795E\u76EF\u8457\u6211\uFF0C\u96A8\u5F8C\u4FBF\u6D88\u5931\u5728\u6211\u7684\u5922\u88E1\u3002\n\n\u800C\u5F9E\u90A3\u4E4B\u5F8C\uFF0C\u7121\u8AD6\u6211\u9192\u4F86\u591A\u5C11\u6B21\uFF0C\u7D61\u816E\u9B0D\u5148\u751F\u90FD\u4E0D\u518D\u51FA\u73FE\u4E26\u5C0D\u6211\u8AAA\u90A3\u53E5\u719F\u6089\u7684\u642D\u8A15\u8A9E\u53E5\u3002\u6211\u5617\u8A66\u5C0B\u627E\u5B83\uFF0C\u4F46\u7D61\u816E\u9B0D\u5148\u751F\u5F9E\u6B64\u6C92\u6709\u518D\u51FA\u73FE\u904E\u4E86\uFF0C\u50C5\u6709\u6578\u91CF\u773E\u591A\u7684\u300C\u9B3C\u9B45\u300D\u5728\u5404\u500B\u623F\u9593\u548C\u8D70\u5ECA\u88E1\u5F98\u5F8A\u3002\n\n\u5B83\u597D\u50CF\u771F\u7684\u96E2\u958B\u6211\u4E86\u3002\n"
  videoClip: {fileID: 32900000, guid: 3c939f10251be4119b4c893ae8fafdd1, type: 3}
