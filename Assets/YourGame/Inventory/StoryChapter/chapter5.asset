  m_Script: {fileID: 11500000, guid: 6aab352a4aa36472a9ad4de79580327d, type: 3}
  m_Name: chapter5
  m_EditorClassIdentifier: 
  title: "\u52C7\u8005\u516C\u4E3B\u4F0A\u7D72\u6CE2"
  content: "\u300C\u9019\u88E1\u5982\u540C\u4E00\u5EA7\u5DE8\u5927\u7684\u8FF7\u5BAE\uFF0C\u6C92\u6709\u4EFB\u4F55\u6307\u5F15\u6839\u672C\u6478\u4E0D\u8457\u65B9\u5411\uFF0C\u5230\u5E95\u662F\u54EA\u4E00\u7FA4\u4EBA\u628A\u9019\u88E1\u8A2D\u8A08\u7684\u9019\u9EBC\u6C92\u4EBA\u6027\u5316\u300D\n\n\n\u9019\u5DF2\u7D93\u662F\u6211\u4E0D\u77E5\u9053\u7B2C\u5E7E\u6B21\u91CD\u65B0\u8207\u7D61\u816E\u9B0D\u5148\u751F\u898B\u9762\uFF0C\u4F46\u8207\u5B83\u6BCF\u6B21\u898B\u9762\uFF0C\u5B83\u90FD\u6703\u5411\u6211\u5410\u69FD\u85DD\u6587\u5712\u5340\u7684\u5EFA\u7BC9\u8A2D\u8A08\u3002\n\n\u300C\u6211\u89BA\u5F97\u52C7\u8005\u516C\u4E3B\u4F0A\u7D72\u6CE2\u9019\u672C\u66F8\u6700\u5927\u7684\u7F3A\u9EDE\u5C31\u662F\u5B83\u7684\u5916\u50B3\uFF0C\u5728\u751F\u4E0B\u5973\u5152\u5F8C\u5C31\u8981\u8207\u4E0D\u77E5\u5F9E\u54EA\u51FA\u73FE\u7684\u9B54\u9F8D\u6C7A\u4E00\u6B7B\u6230\u9084\u8207\u9B54\u9F8D\u540C\u6B78\u65BC\u76E1\uFF0C\u771F\u7684\u5F88\u83AB\u540D\u5176\u5999\u300D\u3002\n\n\u300C\u611F\u89BA\uFF0C\u9019\u6B21\u7684\u7D61\u816E\u9B0D\u5148\u751F\uFF0C\u6BD4\u5E73\u6642\u9084\u6703\u62B1\u6028\u5462\u300D\u3002\n\n\u6211\u5C0F\u8072\u5730\u56DE\u8986\u5B83\uFF0C\u5B83\u537B\u7A81\u7136\u505C\u4E0B\u8173\u6B65\u56DE\u982D\u770B\u50CF\u6211\uFF0C\u4E26\u5728\u5B83\u6C92\u6709\u4E94\u5B98\u7684\u81C9\u4E0A\u6191\u7A7A\u51FA\u73FE\u7684\u5E7E\u6EF4\u6DDA\u6C34\u3002\n\n\u300C\u7562\u7ADF\u6211\u4E0D\u662F\u4F5C\u8005\uFF0C\u6211\u6539\u8B8A\u4E0D\u4E86\u7D50\u5C40\uFF0C\u53EA\u80FD\u6292\u767C\u6211\u7684\u4E0D\u6EFF\u561B\u300D\u3002\n\n\u6211\u4E0D\u61C2\u5B83\u6703\u70BA\u4E00\u672C\u7AE5\u8A71\u6545\u4E8B\u66F8\u7CFE\u7D50\u6210\u9019\u6A23\uFF0C\u4F46\u6211\u7684\u5FC3\u50CF\u662F\u8DDF\u5B83\u5171\u7528\u540C\u4E00\u9846\u4F3C\u7684\uFF0C\u4E5F\u6D41\u4E0B\u540C\u6A23\u7684\u6DDA\u6C34\u3002\n"
  videoClip: {fileID: 0}
