  m_Script: {fileID: 11500000, guid: 6aab352a4aa36472a9ad4de79580327d, type: 3}
  m_Name: chapter4
  m_EditorClassIdentifier: 
  title: "\u91CD\u88FD"
  content: "\u6B63\u7576\u6211\u5C0D\u525B\u525B\u7684\u5922\u5883\u611F\u5230\u56F0\u60D1\uFF0C\u7D61\u816E\u9B0D\u5148\u751F\u8EAB\u7A7F\u68D5\u8272\u897F\u88DD\uFF0C\u8E29\u8457\u602A\u7570\u7684\u6B65\u4F10\uFF0C\u5F9E\u8D70\u5ECA\u76E1\u982D\u4E00\u6B65\u6B65\u8D70\u4F86\uFF0C\u5F35\u958B\u96D9\u81C2\u5728\u6211\u9762\u524D\u5927\u8072\u5730\u5C0D\u6211\u8AAA\uFF1A\u300C\u6B61\u8FCE\u4F86\u5230\u4F0A\u7D72\u6CE2\uFF01\u300D\n\n\u4E00\u5207\u90FD\u8DDF\u524D\u9663\u5B50\u7D93\u6B77\u7684\u4E00\u6A23\u3002\n\n\u300C\u7D61\u816E\u9B0D...\u5148\u751F\u3002\u300D\n\n\u53EA\u898B\u7D61\u816E\u9B0D\u5148\u751F\u6478\u4E86\u6478\u81EA\u5DF1\u7684\u9B0D\u5B50\uFF0C\u5B83\u7684\u81C9\u4E0A\u4E26\u6C92\u6709\u4E94\u5B98\u3002\u300C\u7D61\u816E\u9B0D\u5148\u751F?
    \u4F60\u662F\u5728\u8AAA\u6211\u7684\u9B0D\u5B50\u55CE? \u6069! \u771F\u662F\u500B\u597D\u540D\u5B57!
    \u4EE5\u5F8C\u8ACB\u53EB\u6211\u7D61\u816E\u9B0D\u5148\u751F\u5427! \u300D\n\n\u300C...\u4F60\u5FD8\u8A18\u4E86\u55CE?\u300D\n\n\u300C\u6211\u61C9\u8A72\u8981\u8A18\u5F97\u4EC0\u9EBC\u55CE?
    \u963F\uFF01\u83AB\u975E\u5C0F\u59D1\u5A18\u5C0D\u85DD\u6587\u7279\u5340\u6709\u5370\u8C61?
    \u300D\u7D61\u816E\u9B0D\u5148\u751F\u7528\u548C\u525B\u525B\u4E00\u6A23\u7684\u65B9\u5F0F\uFF0C\u6EAB\u67D4\u7684\u62C9\u8457\u6211\u7AD9\u8D77\u8EAB\uFF0C\u8A71\u984C\u7528\u5DE7\u5999\u7684\u65B9\u5F0F\u8F49\u5411\u4E86\u5712\u5340\uFF0C\u56E0\u6B64\u6211\u53EA\u597D\u8FF7\u8FF7\u7CCA\u7CCA\u7684\u8DDF\u8457\u7D61\u816E\u9B0D\u5148\u751F\uFF0C\u53C3\u52A0\u7B2C\u4E8C\u6B21\u7684\u4F0A\u65AF\u6CE2\u85DD\u6587\u5712\u5340\u5C0E\u89BD\u3002\n\n\u4E00\u8DEF\u4E0A\uFF0C\u5B83\u6709\u8AAA\u6709\u7B11\uFF0C\u91CD\u8907\u5206\u4EAB\u8457\u5B83\u8DDF\u6211\u8AAA\u904E\u7684\u6545\u4E8B\uFF0C\u5F77\u5F7F\u548C\u6211\u6839\u672C\u5C31\u6C92\u63A5\u89F8\u904E\u3002\n\n\u6700\u5F8C\u6211\u5011\u4F86\u5230\u4E86\u8352\u5EE2\u7684\u51FA\u53E3\u3002\u5B83\u518D\u6B21\u7528\u56B4\u8085\u7684\u53E3\u6C23\u554F\u4E86\u6211\u4E00\u6A23\u7684\u554F\u984C\uFF1A\n\n\u300C\u4F60\u60F3\u96E2\u958B\u9019\u88E1\u55CE\uFF1F\u300D\n\n\u300C\u90A3\u500B...\u300D\u6211\u5617\u8A66\u60F3\u591A\u554F\u4E00\u4E9B\u7D30\u7BC0\uFF0C\u4F46\u7D61\u816E\u9B0D\u5148\u751F\u4F9D\u7136\u4E0D\u7D66\u6211\u6A5F\u6703\u56DE\u7B54\u3002\u5B83\u6253\u958B\u7BB1\u5B50\u6E96\u5099\u548C\u6211\u89E3\u91CB\u9019\u88E1\u7684\u898F\u5247\uFF0C\u4F46\u52D5\u4F5C\u5FFD\u7136\u505C\u4E86\u4E0B\u4F86\u3002\n\n(...?)\n\n\u6211\u5F9E\u505C\u9813\u7684\u52D5\u4F5C\u4E2D\u770B\u51FA\u4E86\u5B83\u7684\u9707\u9A5A\uFF0C\u62B1\u8457\u7591\u60D1\uFF0C\u6211\u671D\u8457\u7BB1\u5B50\u7684\u65B9\u5411\u770B\u53BB\u3002\n\n\u525B\u525B\u627E\u5230\u904E\u7684\u6771\u897F\u6B63\u975C\u975C\u5730\u8EBA\u5728\u7BB1\u5B50\u5167\u3002\n\n\u7A7A\u6C23\u51DD\u7D50\u4E86\u6578\u79D2\uFF0C\u7D61\u816E\u9B0D\u5148\u751F\u5C07\u7BB1\u5B50\u95D4\u4E0A\u4E26\u7DE9\u7DE9\u8E72\u4E0B\uFF0C\u96D6\u7136\u770B\u4E0D\u5230\u4ED6\u7684\u773C\u775B\uFF0C\u4F46\u6211\u60F3\u4ED6\u6B63\u5728\u5C08\u5FC3\u7684\u51DD\u8996\u8457\u6211\u3002\n\n\u300C\u770B\u8D77\u4F86\uFF0C\u59B3\u90FD\u77E5\u9053\u4E86\u3002\u300D\u5B83\u56B4\u8085\u7684\u53E3\u543B\u6C92\u6709\u6539\u8B8A\uFF0C\u4F46\u5728\u5176\u4E2D\u53C3\u96DC\u8457\u4E00\u7D72\u6EAB\u67D4\u3002\u300C\u4F60\u8981\u76F8\u4FE1\uFF0C\u201D\u82AF\u201D\u662F\u5B58\u5728\u7684\u3002\u62B1\u6301\u8457\u9019\u500B\u4FE1\u5FF5\u5C0B\u627E\u5427\u3002\u4E0D\u8981\u653E\u68C4\u5C0B\u627E\u5B83\u7684\u8E64\u8DE1\uFF0C\u5426\u5247\uFF0C\u4F60\u5C07\u8EBA\u5165\u5C01\u9589\u5167\u5FC3\u7684\u68FA\u6750\u88E1\u300D\u3002\n\n\u6211\u4E0D\u61C2\u7D61\u816E\u9B0D\u5148\u751F\u5728\u8AAA\u4EC0\u9EBC\uFF0C\u4F46\u5B83\u548C\u525B\u525B\u4E00\u6A23\uFF0C\u7A81\u7136\u7684\u6D88\u5931\u4E86\u3002\n"
  videoClip: {fileID: 32900000, guid: d39a0f4fbb8ec4fd6b3079ee1975f728, type: 3}
