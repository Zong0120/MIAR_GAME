  m_Script: {fileID: 11500000, guid: 6aab352a4aa36472a9ad4de79580327d, type: 3}
  m_Name: chapter2
  m_EditorClassIdentifier: 
  title: "\u7D61\u816E\u9B0D\u5148\u751F"
  content: "\u7D61\u816E\u9B0D\u5148\u751F\u5E36\u8457\u6211\u5728\u9019\u5EA7\u5EE2\u68C4\u7684\u5EFA\u7BC9\u88E1\u9592\u901B\uFF0C\u4E00\u8DEF\u4E0A\u5B83\u544A\u8A34\u5F88\u591A\u6211\u4E0D\u77E5\u9053\u7684\u4E8B\uFF0C\u4F8B\u5982\u66FE\u7D93\u6709\u5F88\u591A\u5F88\u591A\u4EBA\u4F86\u9019\u500B\u5730\u65B9\u73A9\u3001\u4F0A\u7D72\u6CE2\u85DD\u6587\u5712\u5340\u662F\u4EE5\u7AE5\u8A71\u66F8\u4E2D\u82F1\u52C7\u72A7\u7272\u7684\u9A0E\u58EB\u516C\u4E3B\u201D\u4F0A\u7D72\u6CE2\u201D\u800C\u547D\u540D\u7684\u6709\u8DA3\u77E5\u8B58\u3002\n\n\u4E00\u8DEF\u4E0A\uFF0C\u7D61\u816E\u9B0D\u5148\u751F\u7D61\u7E79\u4E0D\u6C7A\u7684\u5206\u4EAB\u8457\u9019\u88E1\u904E\u53BB\u7684\u98A8\u5149\uFF0C\u4F30\u8A08\u662F\u64D4\u5FC3\u6211\u5411\u525B\u624D\u90A3\u6A23\u54ED\u5F97\u4E0D\u505C\uFF0C\u624D\u6703\u5288\u54E9\u74DC\u62C9\u7684\u4E00\u76F4\u8B1B\u8457\u540C\u6A23\u7684\u4E8B\u3002\n\n\u300C\u9019\u88E1\u5DF2\u7D93\u5012\u9589\u4E86\uFF0C\u81EA\u5F9E\u90A3\u6B21\u5BD2\u6D41\u4F86\u8972\u5F8C\uFF0C\u9664\u4E86\u59B3\u4E4B\u5916\uFF0C\u6211\u518D\u4E5F\u6C92\u770B\u904E\u6D3B\u751F\u751F\u7684\u4EBA\u300D\u3002\n\n\u5B83\u7A81\u7136\u56B4\u8085\u7684\u8AAA\u8457\uFF0C\u4E26\u7E7C\u7E8C\u8AAA\u9053\u3002\n\n\u300C\u5982\u679C\u59B3\u60F3\u8981\u96E2\u958B\u9019\u88E1\uFF0C\u5C31\u5F97\u627E\u51FA\u85CF\u5728\u9928\u88E1\u7684\u201D\u82AF\u201D\uFF0C\u53EA\u6709\u5B83\u624D\u80FD\u6253\u958B\u96E2\u958B\u9019\u88E1\u7684\u901A\u9053\u300D\u3002\n\n\u300C\u5B83\u53EF\u80FD\u662F\u7F50\u5B50\u3001\u76F4\u7B1B\uFF0C\u751A\u81F3\u662F\u4E00\u628A\u9577\u7684\u6975\u5176\u8A6D\u7570\u7684\u96F7\u5C04\u69CD\u6216\u662F...\u300D\u3002\n\n\u8A71\u9084\u6C92\u8AAA\u5B8C\uFF0C\u5B83\u4FBF\u6D88\u5931\u5728\u6211\u7684\u8996\u91CE\u4E2D\u3002\n"
  videoClip: {fileID: 0}
