  m_Script: {fileID: 11500000, guid: 6aab352a4aa36472a9ad4de79580327d, type: 3}
  m_Name: chapter3
  m_EditorClassIdentifier: 
  title: "\u5922"
  content: "\u807D\u8D77\u4F86\uFF0C\u5C07\u201D\u82AF\u201D\u653E\u9032\u7BB1\u5B50\u88E1\uFF0C\u6253\u958B\u51FA\u53E3\uFF0C\u4FBF\u662F\u9019\u88E1\u7684\u898F\u5247\u3002\n\n\u300C\u201C\u82AF\u201D\u7A76\u7ADF\u662F\u4EC0\u9EBC\uFF1F\u300D\u5E36\u8457\u9019\u500B\u7591\u554F\uFF0C\u6211\u958B\u59CB\u7368\u81EA\u63A2\u7D22\u6574\u500B\u5712\u5340\uFF0C\u4E26\u5C07\u6240\u6709\u53EF\u80FD\u7684\u7269\u54C1\u90FD\u5E36\u5728\u8EAB\u4E0A\u3002\n\n\u5F9E\u5EC1\u6240\u64BF\u4F86\u7684\u5B50\u5F48\u3001\u5947\u602A\u7684\u6642\u9418\u3001\u751A\u81F3\u4E00\u9846\u78DA\u982D\uFF0C\u8001\u5BE6\u8AAA\u6211\u771F\u4E0D\u660E\u767D\u9019\u4E9B\u6771\u897F\u5230\u5E95\u54EA\u88E1\u4F86\u7684\u3002\u7136\u800C\uFF0C\u5118\u7BA1\u52AA\u529B\u7684\u5C0B\u627E\u4EFB\u4F55\u7269\u54C1\uFF0C\u4F46\u4F3C\u4E4E\u4E00\u9EDE\u7528\u90FD\u6C92\u6709\uFF0C\u74B0\u5883\u6C92\u6709\u6539\u8B8A\uFF0C\u51FA\u53E3\u6C92\u6709\u6253\u958B\u7684\u8DE1\u8C61\uFF0C\u7D61\u816E\u9B0D\u5148\u751F\u4E5F\u4F9D\u7136\u6C92\u6709\u56DE\u4F86\u3002\n\n\u300C\u4EFB\u4F55\u6771\u897F\u90FD\u6709\u53EF\u80FD...\u300D\u6211\u770B\u8457\u8490\u96C6\u4F86\u7684\u9019\u4E9B\u7269\u54C1\u6C89\u601D\u8457\u3002\u4E5F\u8A31\u9084\u6709\u6211\u6C92\u627E\u5230\u7684\u5730\u65B9\uFF1F\u6211\u908A\u9019\u6A23\u60F3\u8457\u908A\u7DE9\u7DE9\u7AD9\u8D77\u8EAB\uFF0C\u6253\u7B97\u518D\u91CD\u65B0\u5927\u7BC4\u570D\u627E\u4E00\u6B21...\n\n\u2026\u604D\u60DA\u9593\uFF0C\u6211\u7A81\u7136\u611F\u5230\u4E00\u9663\u6688\u7729\uFF0C\u63A5\u8457\u9084\u4F86\u4E0D\u53CA\u53CD\u61C9\uFF0C\u6211\u91CD\u6454\u5728\u5730\u3002\n\n\u773C\u76AE\u4E0D\u7531\u81EA\u4E3B\u5730\u95D4\u4E0A\uFF0C\u6211\u5931\u53BB\u4E86\u610F\u8B58\u3002\n\n\u5728\u5922\u88E1\uFF0C\u4F0A\u7D72\u6CE2\u8207\u6709\u8457\u4E94\u5B98\u7684\u7D61\u816E\u9B0D\u5148\u751F\u727D\u8457\u6211\u7684\u624B\u4E00\u540C\u770B\u8457\u9060\u65B9\u7684\u5915\u967D\u3002\u6211\u7684\u5169\u96BB\u5C0F\u624B\u5206\u5225\u88AB\u5305\u88F9\u5728\u4ED6\u5011\u7684\u5927\u624B\u5167\uFF0C\u6307\u5C16\u611F\u53D7\u8457\u4ED6\u5011\u638C\u5FC3\u7684\u6EAB\u6696\uFF0C\u5167\u5FC3\u4F3C\u4E4E\u88AB\u5915\u967D\u5F71\u97FF\uFF0C\u8B8A\u5F97\u6696\u70D8\u70D8\u7684\u3002\n\n\u7E31\u4F7F\u56DB\u5468\u7684\u74B0\u5883\u4EE4\u6211\u611F\u5230\u65E2\u719F\u6089\u53C8\u964C\u751F\uFF0C\u4F46\u6B64\u6642\u6B64\u523B\u6211\u537B\u53EA\u89BA\u5F97\u6211\u662F\u4E16\u4E0A\u6700\u5E78\u798F\u7684\u4EBA\u3002\n\n\u7B49\u6211\u610F\u8B58\u5230\u7684\u6642\u5019\uFF0C\u6211\u518D\u5EA6\u56DE\u5230\u6700\u521D\u9192\u4F86\u7684\u8D70\u5ECA\u3002\n\n\u525B\u525B\u7D93\u6B77\u7684\u4E00\u5207\u7686\u662F\u5982\u6B64\u771F\u5BE6\u3002"
  videoClip: {fileID: 32900000, guid: b250f4617e00d4847abdf42a41d37d05, type: 3}
